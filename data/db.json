      </div>\n    </nav>\n\n    <!-- Hero -->\n    <section class=\"pt-32 pb-20 container mx-auto px-6 flex flex-col md:flex-row items-center gap-12\">\n        <div class=\"md:w-1/2\">\n            <h2 class=\"text-5xl md:text-7xl font-extrabold leading-tight mb-6\">Gaya Modern, <span class=\"text-[#06B6D4]\">Kualitas Maksimal</span> Setiap Hari</h2>\n            <p class=\"text-lg text-slate-400 mb-8\">Koleksi pakaian streetwear terbaru 2026 dengan bahan katun combed 24s adem, potongan rapi, dan diskon 20%.</p>\n            <div class=\"flex gap-4\">\n                <a href=\"#katalog\" class=\"bg-[#4F46E5] px-8 py-4 rounded-2xl font-bold hover:bg-[#4338CA] transition\">Belanja Sekarang</a>\n                <div class=\"flex items-center gap-2 text-sm text-[#06B6D4] font-bold\">\n                    <i class=\"fa-solid fa-shield-check\"></i> 100% Original\n                </div>\n            </div>\n        </div>\n        <div class=\"md:w-1/2\">\n            <img src=\"https://i.imgur.com/492vOq5.jpg\" alt=\"Hero\" class=\"rounded-3xl shadow-custom w-full\">\n        </div>\n    </section>\n\n    <!-- Katalog -->\n    <section id=\"katalog\" class=\"py-20 bg-slate-900/50\">\n        <div class=\"container mx-auto px-6\">\n            <h3 class=\"text-3xl font-bold mb-12 text-center\">Produk Terlaris Minggu Ini</h3>\n            <div class=\"grid md:grid-cols-3 gap-8\" id=\"product-list\">\n                <!-- Product Cards -->\n                <script>\n                    const products = [\n                        { name: \"Kaos Polos Heavyweight 24s Black\", price: 129000, img: \"https://i.imgur.com/8Km9tLL.jpg\", desc: \"Katun combed 24s tebal tidak menerawang, jahitan rantai kuat.\" },\n                        { name: \"Hoodie Fleece Street Noir\", price: 249000, img: \"https://i.imgur.com/V7RkJ3R.jpg\", desc: \"Bahan fleece hangat dengan tali serut premium dan kantong kanguru.\" },\n                        { name: \"Celana Chino Slim Stretch Grey\", price: 189000, img: \"https://i.imgur.com/mG7P2sJ.jpg\", desc: \"Katun twill stretch lentur nyaman dipakai harian kerja atau santai.\" }\n                    ];\n                    \n                    const list = document.getElementById('product-list');\n                    products.forEach(p => {\n                        list.innerHTML += `\n                            <div class=\"bg-slate-800 p-6 border-radius shadow-custom\">\n                                <img src=\"${p.img}\" class=\"rounded-2xl mb-4 w-full h-64 object-cover\">\n                                <h4 class=\"text-xl font-bold mb-2\">${p.name}</h4>\n                                <p class=\"text-sm text-slate-400 mb-4\">${p.desc}</p>\n                                <p class=\"text-2xl font-bold text-[#06B6D4] mb-4\">Rp ${p.price.toLocaleString()}</p>\n                                <button onclick=\"addToCart('${p.name}', ${p.price})\" class=\"w-full bg-[#4F46E5] py-3 rounded-xl font-bold hover:bg-[#4338CA]\">\n                                    <i class=\"fa-brands fa-whatsapp mr-2\"></i> Beli via WhatsApp\n                                </button>\n                            </div>\n                        `;\n                    });\n                </script>\n            </div>\n        </div>\n    </section>\n\n    <!-- Tentang & FAQ -->\n    <section id=\"tentang\" class=\"py-20 container mx-auto px-6\">\n        <div class=\"max-w-3xl mx-auto text-center mb-16\">\n            <h3 class=\"text-3xl font-bold mb-6\">Tentang Vimos Apparel</h3>\n            <p class=\"text-slate-400\">Vimos Apparel didirikan untuk menghadirkan tren fashion berkualitas premium dengan proses pemesanan praktis dan pengiriman kilat.</p>\n        </div>\n        \n        <div class=\"max-w-2xl mx-auto space-y-4\">\n            <details class=\"bg-slate-800 p-6 border-radius\">\n                <summary class=\"font-bold cursor-pointer\">Bagaimana cara pemesanan?</summary>\n                <p class=\"mt-4 text-slate-400\">Klik tombol WhatsApp pada produk pilihan Anda, rincian produk otomatis terisi.</p>\n            </details>\n            <details class=\"bg-slate-800 p-6 border-radius\">\n                <summary class=\"font-bold cursor-pointer\">Berapa lama pengiriman?</summary>\n                <p class=\"mt-4 text-slate-400\">1-3 hari kerja ke seluruh Indonesia.</p>\n            </details>\n        </div>\n    </section>\n\n    <!-- Footer -->\n    <footer class=\"py-12 bg-slate-950 border-t border-slate-800\">\n        <div class=\"container mx-auto px-6 grid md:grid-cols-3 gap-12\">\n            <div><h4 class=\"text-xl font-bold mb-4\">VIMOS APPAREL</h4><p class=\"text-slate-500\">Streetwear premium untuk gaya hidup modern.</p></div>\n            <div><h4 class=\"text-xl font-bold mb-4\">Kontak</h4><p class=\"text-slate-500\">WhatsApp: 081234567890</p></div>\n            <div><h4 class=\"text-xl font-bold mb-4\">Lokasi</h4><p class=\"text-slate-500\">Jakarta, Indonesia</p></div>\n        </div>\n    </footer>\n\n    <!-- Floating WA -->\n    <a href=\"https://wa.me/6281234567890\" class=\"fixed bottom-6 right-6 bg-green-500 text-white p-4 rounded-full text-2xl shadow-lg hover:scale-110 transition\">\n        <i class=\"fa-brands fa-whatsapp\"></i>\n    </a>\n\n    <!-- Cart Modal -->\n    <div id=\"cart-modal\" class=\"hidden fixed inset-0 bg-black/80 z-[60] flex justify-end\">\n        <div class=\"w-full max-w-sm bg-slate-900 h-full p-8 overflow-y-auto\">\n            <div class=\"flex justify-between items-center mb-8\">\n                <h3 class=\"text-xl font-bold\">Keranjang Saya</h3>\n                <button onclick=\"toggleCart()\" class=\"text-2xl\">&times;</button>\n            </div>\n            <div id=\"cart-items\" class=\"space-y-4 mb-8\"></div>\n            <button id=\"checkout-btn\" class=\"w-full bg-[#06B6D4] py-4 rounded-xl font-bold hidden\">Checkout via WhatsApp</button>\n        </div>\n    </div>\n\n    <script>\n        let cart = [];\n        function toggleCart() { document.getElementById('cart-modal').classList.toggle('hidden'); }\n        \n        function addToCart(name, price) {\n            cart.push({name, price});\n            document.getElementById('cart-count').innerText = cart.length;\n            document.getElementById('checkout-btn').classList.remove('hidden');\n            alert(name + ' ditambahkan ke keranjang!');\n        }\n\n        document.getElementById('checkout-btn').onclick = () => {\n            let msg = \"Halo Vimos Apparel, saya ingin membeli: \";\n            cart.forEach(item => msg += `${item.name} (Rp ${item.price.toLocaleString()}), `);\n            window.open('https://wa.me/6281234567890?text=' + encodeURIComponent(msg), '_blank');\n        };\n    </script>\n</body>\n</html>",
