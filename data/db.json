ands fa-whatsapp\"></i>\n    </a>\n\n    <!-- Cart Modal -->\n    <div id=\"cartModal\" class=\"hidden fixed inset-0 bg-black/80 z-[60] flex items-center justify-center p-6\">\n        <div class=\"bg-slate-900 p-8 border-radius w-full max-w-md\">\n            <h3 class=\"text-2xl font-bold mb-4\">Keranjang Belanja</h3>\n            <div id=\"cartItems\" class=\"text-slate-400 mb-6\"></div>\n            <button onclick=\"checkout()\" class=\"w-full bg-cyan-500 py-3 rounded-xl font-bold\">Checkout via WhatsApp</button>\n            <button onclick=\"toggleCart()\" class=\"w-full mt-4 text-slate-500\">Tutup</button>\n        </div>\n    </div>\n\n    <script>\n        let cart = [];\n        function toggleCart() { document.getElementById('cartModal').classList.toggle('hidden'); }\n        function addToCart(name, price) {\n            cart.push({name, price});\n            document.getElementById('cartCount').innerText = cart.length;\n            alert('Produk ditambahkan ke keranjang!');\n        }\n        function checkout() {\n            let message = \"Halo Vimos Apparel, saya ingin membeli:%0A\";\n            cart.forEach(item => message += `- ${item.name} (Rp ${item.price})%0A`);\n            window.open('https://wa.me/6281234567890?text=' + message, '_blank');\n        }\n    </script>\n</body>\n</html>",
